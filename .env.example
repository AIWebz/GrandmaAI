# --- Core ---
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# --- AI provider (swappable via AI_PROVIDER: "ollama" | "anthropic") ---
# Default is "ollama" - a local model, no API key or billing account needed.
# Install Ollama (https://ollama.com) on whatever machine runs this server,
# then pull a tool-calling-capable model and a vision model:
#   ollama pull llama3.1
#   ollama pull llava
# and just run the Ollama app/daemon - the server talks to it over localhost.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_VISION_MODEL="llava"

# --- Only used when AI_PROVIDER="anthropic" ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_VISION_MODEL="claude-sonnet-5"

# --- Free tier usage caps ---
FREE_DAILY_CHAT_CAP=15
FREE_DAILY_RECIPE_CAP=3
REWARDED_UNLOCK_DAILY_CAP=3

# --- Auth providers (swappable via AUTH_PROVIDER list) ---
APPLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# --- Push (swappable via PUSH_PROVIDER: expo | fcm | apns) ---
PUSH_PROVIDER="expo"
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# --- Grandma+ subscription: $14.99/month ---
GRANDMA_PLUS_PRICE_USD=14.99

# Primary billing rail: Stripe. Get keys from https://dashboard.stripe.com/apikeys
# (use the test-mode keys while developing), then run `npm run stripe:setup`
# to auto-create the Grandma+ product/price and print STRIPE_PRICE_ID_MONTHLY.
# For the webhook secret: `stripe listen --forward-to localhost:4000/billing/webhook`
# prints one for local dev; in production, create a webhook endpoint in the
# Stripe Dashboard pointed at https://<your-domain>/billing/webhook and copy
# its signing secret instead.
APP_URL="http://localhost:4000"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""

# --- Alternate billing rail: native App Store / Play Store IAP (optional - see docs/ARCHITECTURE.md) ---
APPLE_SHARED_SECRET=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GRANDMA_PLUS_MONTHLY_PRODUCT_ID="grandma_plus_monthly"
GRANDMA_PLUS_ANNUAL_PRODUCT_ID="grandma_plus_annual"

# --- Ads (swappable via ADS_PROVIDER) ---
# Leave all of these blank to run entirely on Google's public AdMob test
# ids (real ads render, in test mode, with zero AdMob account setup - see
# GET /config/ads). Fill in a real AdMob account's app + ad unit ids here
# to start earning real revenue with no client rebuild.
ADS_PROVIDER="admob"
ADMOB_APP_ID_IOS=""
ADMOB_APP_ID_ANDROID=""
ADMOB_BANNER_AD_UNIT_ID_IOS=""
ADMOB_BANNER_AD_UNIT_ID_ANDROID=""
ADMOB_INTERSTITIAL_AD_UNIT_ID_IOS=""
ADMOB_INTERSTITIAL_AD_UNIT_ID_ANDROID=""
ADMOB_REWARDED_AD_UNIT_ID_IOS=""
ADMOB_REWARDED_AD_UNIT_ID_ANDROID=""
